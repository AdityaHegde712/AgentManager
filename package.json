{
  "name": "agent-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "start": "tsx src/server/main.ts",
